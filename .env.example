# ---- Supabase (Project Settings → API) ----
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # SERVER ONLY — never put in assets/config.js

# ---- Lemon Squeezy (Settings → API / Webhooks) ----
LEMONSQUEEZY_API_KEY=eyJ...
LEMONSQUEEZY_STORE_ID=12345
LEMONSQUEEZY_WEBHOOK_SECRET=a-long-random-string   # same value you type in the webhook form

# ---- Site ----
SITE_URL=https://your-domain.com             # used for checkout redirect + CORS

# ---- Optional: AI writing for the Premium package ----
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
